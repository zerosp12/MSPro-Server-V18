;==================================================
; PartyMonsterFormulaMaxLevelPlus
;==================================================
;   Margin added to Monster level before the Party-Level exp Penalty.
;   If PartyLevel > (MonsterLevel + Plus): Exp * (MonsterLevel + Plus) / PartyLevel.
;   Higher = Penalty starts Later and Softer.

PartyMonsterFormulaLevelChange = 65

;==================================================
; PartyMonsterFormulaLevelChange
;==================================================
;   Monster level threshold for an extra Exp Bonus (Level >= Value).
;   Solo:  Bonus scales with how far above threshold, weighted by MonsterLevel / 4
;   Party: Bonus inverse to Player Level -> (200 - PlayerLevel/5), capped at 800
;   Higher = Fewer monsters Affected.

PartyMonsterFormulaMaxLevelPlus = 10

